@model GiftOfTheGivers.Models.ViewModels.VolunteerRegisterViewModel
@{
    ViewData["Title"] = "Volunteer";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>Register your interest to volunteer</h2>
        <form asp-controller="Volunteer" asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Skills" class="form-label"></label>
                <input asp-for="Skills" class="form-control" placeholder="e.g. First aid, logistics" />
                <span asp-validation-for="Skills" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Availability" class="form-label"></label>
                <input asp-for="Availability" class="form-control" placeholder="e.g. Weekends, Gauteng region" />
                <span asp-validation-for="Availability" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-danger">Submit</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
