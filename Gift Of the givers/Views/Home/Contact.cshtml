@model GiftOfTheGivers.Models.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Contact";
}

<h2>Contact Us</h2>
<p class="text-muted">Have a question about volunteering, a donation, or an ongoing relief project? Send us an enquiry below.</p>

@if (TempData["ContactSuccess"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <form asp-controller="Home" asp-action="Contact" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Surname" class="form-label"></label>
                    <input asp-for="Surname" class="form-control" placeholder="Surname" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" placeholder="e.g. 072 091 1241" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Enquiry" class="form-label"></label>
                <textarea asp-for="Enquiry" class="form-control" rows="4" placeholder="Write your enquiry here..."></textarea>
                <span asp-validation-for="Enquiry" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-danger">Submit</button>
        </form>

        <hr class="my-4" />
        <p><strong>Email:</strong> <a href="mailto:info@giftofthegivers.org">info@giftofthegivers.org</a></p>
        <p><strong>Phone:</strong> +27 31 674 8639</p>
        <p><strong>Location:</strong> 239 Pretorius St, Pretoria Central, Pretoria, 0126</p>
    </div>

    <div class="col-lg-6">

        <div class="ratio ratio-4x3 rounded-3 overflow-hidden border">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3593.6845072485553!2d28.1876132741041!3d-25.74794487736054!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1e9561eb88fde125%3A0xa6b2b426ca41034!2sRosebank%20College%20Pretoria%20Campus!5e0!3m2!1sen!2sza!4v1787726664764!5m2!1sen!2sza"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}