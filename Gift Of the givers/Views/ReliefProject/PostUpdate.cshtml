@model GiftOfTheGivers.Models.ReliefUpdate
@{
    ViewData["Title"] = "Post update";
    var project = ViewBag.Project as GiftOfTheGivers.Models.ReliefProject;
}

<h2>Post an update — @project?.ProjectName</h2>

<form asp-controller="ReliefProject" asp-action="PostUpdate" method="post">
    <input type="hidden" asp-for="ProjectId" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Content" class="form-label">Update</label>
        <textarea asp-for="Content" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-danger">Post</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
