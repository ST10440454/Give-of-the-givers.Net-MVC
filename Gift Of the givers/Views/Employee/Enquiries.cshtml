@model List<GiftOfTheGivers.Models.ContactEnquiry>
@{
    ViewData["Title"] = "Enquiries";
}

<h2>Enquiries</h2>
<p class="text-muted">Messages submitted through the public Contact Us form.</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No enquiries have been submitted yet.</div>
}
else
{
    <div class="accordion" id="enquiryAccordion">
        @foreach (var e in Model)
        {
            var headingId = $"heading{e.Id}";
            var collapseId = $"collapse{e.Id}";
            <div class="accordion-item">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                        <span class="fw-semibold me-2">@e.Name @e.Surname</span>
                        <span class="text-muted small">@e.SubmittedAt.ToString("dd MMM yyyy HH:mm")</span>
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#enquiryAccordion">
                    <div class="accordion-body">
                        <p><strong>Email:</strong> <a href="mailto:@e.Email">@e.Email</a></p>
                        @if (!string.IsNullOrWhiteSpace(e.Phone))
                        {
                            <p><strong>Phone:</strong> @e.Phone</p>
                        }
                        <p class="mb-0">@e.Enquiry</p>
                    </div>
                </div>
            </div>
        }
    </div>
}